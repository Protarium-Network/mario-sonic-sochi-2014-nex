# Mario & Sonic at the Sochi 2014 Olympic Winter Games - NEX server config.
# Copy to .env and fill in. All names are namespaced PN_SOCHI2014_*.

# --- PRUDP listeners ---
PN_SOCHI2014_AUTH_PORT=26000
PN_SOCHI2014_SECURE_PORT=26001
# Host the client is told to reach the secure server on. MUST be short: the
# retail binary truncates it into a ~15-char buffer.
PN_SOCHI2014_SECURE_HOST=localhost

# --- Database (ranking + DataStore + matchmaking, one database) ---
PN_SOCHI2014_POSTGRES_URI=postgres://sochi2014:sochi2014@localhost:5432/sochi2014?sslmode=disable

# --- Kerberos / system accounts ---
PN_SOCHI2014_KERBEROS_PASSWORD=change-me

# --- Auth mode ----------------------------------------------------------
# 1 = isolated preservation mode: accounts from settings.json, login token
#     not validated. Leave the two NEX_* vars below empty.
PN_SOCHI2014_LOCAL_MODE=1
PN_SOCHI2014_SETTINGS_PATH=settings.json

# Required only when PN_SOCHI2014_LOCAL_MODE is not 1:
PN_SOCHI2014_NEX_TOKEN_AES_KEY=
PN_SOCHI2014_NEX_PASSWORD_SECRET=

# --- Optional: DataStore score attachments (ghosts / photos) ----------
PN_S3_ENDPOINT=
PN_S3_ACCESS_KEY=
PN_S3_SECRET_KEY=
PN_S3_BUCKET=sochi2014-datastore
